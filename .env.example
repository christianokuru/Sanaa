# Public URL of the site (no trailing slash). Used for payment and email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). Leave empty to run in demo mode with sample courses.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Flutterwave (Dashboard > Settings > API keys). Use test keys first.
FLW_SECRET_KEY=
# Dashboard > Settings > Webhooks > "Secret hash". Set the webhook URL to {SITE_URL}/api/webhooks/flutterwave
FLW_WEBHOOK_HASH=

# Bunny Stream (Stream > your library > API)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Stream library CDN hostname, e.g. vz-abc123-456.b-cdn.net
BUNNY_STREAM_CDN_HOST=
# Optional: CDN token authentication key (library > Security). Protects videos from being shared.
BUNNY_STREAM_TOKEN_KEY=

# Platform commission (0.2 = 20%)
PLATFORM_FEE_RATE=0.2
